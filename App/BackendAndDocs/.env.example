# ==============================================================================
# Daylight Money (Australian Personal Finance Platform)
# Environment Variables Template (.env.example)
# NEVER commit live credentials, secrets, or API keys to version control.
# ==============================================================================

APP_ENV=development
APP_BRAND_NAME="Daylight Money"
DEFAULT_CURRENCY=AUD
DEFAULT_LOCALE=en-AU
DEFAULT_TIMEZONE=Australia/Sydney

# PostgreSQL 16+ Primary Database Connection (ap-southeast-2 Sydney)
DATABASE_URL=postgresql+asyncpg://daylight_app:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/daylight_au

# Redis / Background Job Queue (Statement Parsing & Recurring Detection)
REDIS_URL=redis://localhost:6379/0

# Authentication & Session Security (Argon2id + Rotating Refresh Tokens)
# Client Auth Mode: "localKeychainVault" (offline single-device Keychain) or "remoteIdentityProvider" (HTTPS OIDC / Supabase / FastAPI Auth)
DAYLIGHT_AUTH_PROVIDER=localKeychainVault
DAYLIGHT_AUTH_BASE_URL=https://api.daylightmoney.com.au/v1/auth
DAYLIGHT_KEYCHAIN_SERVICE_ID=au.com.daylightmoney.auth.v1
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_PUBLIC_KEY=REPLACE_WITH_SUPABASE_ANON_PUBLIC_KEY
SESSION_SECRET_KEY=REPLACE_WITH_32_BYTE_CSPRNG_BASE64_KEY_AT_RUNTIME
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
CSRF_PROTECTION_ENABLED=true

# Australian Consumer Data Right (CDR / Open Banking) Adapter Configuration
# Set CDR_ADAPTER_MODE=sandbox unless ACCC Data Recipient accreditation is active.
CDR_ADAPTER_MODE=sandbox
CDR_SANDBOX_BASE_URL=https://sandbox.cdr.gov.au/mock-data-holder/v1
CDR_ACCREDITED_RECIPIENT_ID=

# Upload & Rate-Limit Controls
MAX_CSV_STATEMENT_UPLOAD_BYTES=10485760
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_IMPORT_PER_MINUTE=15

# Observability & Structured Logging (PII & Dollar Redaction Enabled)
LOG_LEVEL=INFO
REDACT_FINANCIAL_AMOUNTS_IN_LOGS=true
SENTRY_DSN=
